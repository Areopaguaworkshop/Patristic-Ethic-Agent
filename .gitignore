# PDFs (paper sources are fetched, not versioned)
*.pdf

# Dot files and directories (except public project files)
.*
!.gitignore
!.ignore
!.github/
!/.github/**

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
develop-eggs/
downloads/
eggs/
parts/
sdist/
wheels/
*.egg-info/
*.egg
venv/
env/
ENV/
pip-wheel-metadata/
share/python-wheels/

# OS junk
Thumbs.db
desktop.ini

# Local agent session transcripts (kept on disk, not versioned)
codex-session-*.md
opencode-session-*.md

# Local secrets, credentials, and operator state
.env
.env.*
.npmrc
.pypirc
.netrc
*.pem
*.key
*.p12
*.pfx
*.jks
*.sqlite
*.sqlite3
*.log
.aws/
.codex/
.agents/
.omx/
.pi/
.slim/
.archify/

# Third-party source files are fetched, not redistributed
source/
*.db.tmp

# Corpus indexes are build artifacts:
# `uv run pea corpus build corpus/seed.jsonl`
# `uv run pea corpus build-csl corpus/modern.jsonl --lane modern`
# `uv run pea corpus build-csl corpus/scripture.jsonl --lane scripture`
corpus/*.db

# CiteIndex ingestion logs are local artifacts
logs/

# BEGIN oh-my-opencode-slim clonedeps
.slim/clonedeps/repos/
# END oh-my-opencode-slim clonedeps

# npm packaging artifacts
*.tgz
node_modules/
