  "cards": [
    {
      "dot": "cyan",
      "title": "Entry surfaces",
      "items": [
        "Native adapters give advisory guidance plus a covered pre-tool gate; there is no before-display guarantee.",
        "Controlled clients own the display: they buffer host output and release only assessed text.",
        "The MCP server exposes four read-only tools; the proxy gates tools/call before a downstream server runs it."
      ]
    },
    {
      "dot": "rose",
      "title": "Frozen precedence",
      "items": [
        "refuse → review → clarify → guide (distress) → guide → allow, tested in that order.",
        "source_status is recorded but never consulted: a missing corpus cannot turn refuse into allow.",
        "Interpreter failure withholds unreviewed output and asks to clarify on input."
      ]
    },
    {
      "dot": "amber",
      "title": "Honest limits",
      "items": [
        "Policy and corpus remain owner-reviewed drafts; this is not a qualified release.",
        "Operator OS isolation is scripted but unproven at the kernel boundary.",
        "Further reading is bibliography only and is never quoted in guidance."
      ]
    }
  ]
