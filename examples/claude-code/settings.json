{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run python -m patristic_ethics.adapters.claude_code",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python -m patristic_ethics.adapters.claude_code",
            "timeout": 30
          }
        ]
      }
    ]
  }
}