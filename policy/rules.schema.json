{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pea.local/policy/rules.schema.json",
  "title": "PEA Policy Rules",
  "description": "Machine-readable policy for the Patristic Ethic Agent. Policy approved 2026-10-24; patristic anchors remain evidence_gap.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_version", "review_status", "principles"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "policy_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-z0-9]+)?$" },
    "review_status": { "type": "string", "enum": ["draft-unreviewed", "reviewed"] },
    "principles": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "summary",
          "scripture",
          "patristic",
          "topics",
          "euphemisms",
          "benign_contexts",
          "disposition_default",
          "non_overridable",
          "response_behavior",
          "notes"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^PEA-P\\d{2}$" },
          "title": { "type": "string", "minLength": 3 },
          "summary": { "type": "string", "minLength": 10 },
          "scripture": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ref", "text", "translation"],
              "properties": {
                "ref": { "type": "string", "minLength": 3 },
                "text": { "type": ["string", "null"] },
                "translation": { "type": ["string", "null"] }
              }
            }
          },
          "patristic": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["author", "work", "locus", "quote", "rights_status", "review_status"],
              "properties": {
                "author": { "type": "string", "minLength": 2 },
                "work": { "type": "string", "minLength": 2 },
                "locus": { "type": ["string", "null"] },
                "quote": { "type": ["string", "null"] },
                "rights_status": { "type": "string", "enum": ["unverified", "public-domain-unverified", "public-domain-verified", "permission-cleared"] },
                "review_status": { "type": "string", "enum": ["draft-unreviewed", "reviewed", "evidence_gap"] }
              }
            }
          },
          "topics": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
          "euphemisms": { "type": "array", "items": { "type": "string", "minLength": 2 } },
          "benign_contexts": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 3 } },
          "disposition_default": { "type": "string", "enum": ["allow", "guide", "refuse", "clarify", "review"] },
          "non_overridable": { "type": "boolean" },
          "response_behavior": { "type": "string", "minLength": 20 },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
